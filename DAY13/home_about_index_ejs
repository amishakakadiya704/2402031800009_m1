import express from 'express'
const app = express()

app.set('view engine', 'ejs')

app.get('/', (req, res) => {
    res.send("Home Page")
})

app.get('/about', (req, res) => {
    res.send("<h1>About Page </h1>")
})

app.listen(3000, () => {
console.log("Server started successfully on port: 3000")
})

